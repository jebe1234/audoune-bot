# =============================================
# Hamza Bot — Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# From your Facebook Developer App > Messenger > Page Access Token
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# A secret string YOU choose (can be anything, e.g. hamza-audoune-2024)
VERIFY_TOKEN=hamza-audoune-2024

# From https://build.nvidia.com → Get API Key (free credits available!)
# Supported models: meta/llama-3.1-70b-instruct, mistralai/mistral-7b-instruct-v0.3, etc.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Your personal Facebook Messenger PSID (so Hamza can notify you)
# How to get it: Send a message to your Page from your personal account,
# then check server logs — it will appear as sender.id
ADMIN_PSID=your_personal_messenger_psid_here

# Server port (Railway will set this automatically)
PORT=3000
