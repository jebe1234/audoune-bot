# =============================================
# Hamza Bot — Environment Variables
# Copy this file to .env and fill in the values
# =============================================

# From your Facebook Developer App > Messenger > Page Access Token
PAGE_ACCESS_TOKEN=your_facebook_page_access_token_here

# A secret string YOU choose (can be anything, e.g. hamza-audoune-2024)
VERIFY_TOKEN=hamza-audoune-2024

# From https://build.nvidia.com → Get API Key (free credits available!)
# Supported models: meta/llama-3.1-70b-instruct, mistralai/mistral-7b-instruct-v0.3, etc.
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxx

# Your personal Facebook Messenger PSID (so Hamza can notify you)
# How to get it: Send a message to your Page from your personal account,
# then check server logs — it will appear as sender.id
ADMIN_PSID=your_personal_messenger_psid_here

# Public HTTPS URL of the product photo Messenger should send
PRODUCT_PHOTO_URL=https://example.com/g19s-product-photo.jpg

# Primary AI provider: FreeModel OpenAI-compatible endpoint
FREEMODEL_API_KEY=your_freemodel_api_key_here
FREEMODEL_BASE_URL=https://api.freemodel.dev
FREEMODEL_MODEL=gpt-4o-mini

# Optional Anthropic-compatible fallback. Usually leave disabled for FreeModel Claude Code keys.
ENABLE_ANTHROPIC_FALLBACK=0
ANTHROPIC_BASE_URL=https://cc.freemodel.dev
ANTHROPIC_MODEL=claude-sonnet-4-5

# Optional comma-separated fallback models. First model is tried first.
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.5-flash,gemini-3-flash,gemini-2.5-flash

# Server port (Railway will set this automatically)
PORT=3000
